{
  "name": "@leaflow/sdk",
  "version": "0.1.0",
  "description": "Leaflow 全平台用户侧 API 的 TypeScript SDK",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeaflowNET/sdk.git"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "build": "pnpm generate && node scripts/build-index.mjs && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "typecheck": "pnpm generate && node scripts/build-index.mjs && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "orval": "^7.4.1",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
